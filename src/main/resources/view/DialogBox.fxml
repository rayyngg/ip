<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308" prefWidth="500.0"
         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="390.0" style="-fx-background-color: #fff0f7; -fx-background-radius: 12;
                -fx-padding: 10; -fx-font-size: 14px; -fx-text-fill: black;" text="Label" wrapText="true" />
        <ImageView fx:id="displayPicture" fitHeight="58.0" fitWidth="58.0"
                   preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
    </padding>
</fx:root>
