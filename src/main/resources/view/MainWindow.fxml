<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" prefHeight="700.0" prefWidth="520.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="trybot.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="52.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <VBox fx:id="dialogContainer" spacing="4.0" style="-fx-background-color: transparent;" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type a command..."
                   style="-fx-text-fill: black; -fx-prompt-text-fill: #555555;"
                   AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="10.0"
                   AnchorPane.rightAnchor="92.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput" prefWidth="78.0" text="Send"
                AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="10.0" />
    </children>
</AnchorPane>
